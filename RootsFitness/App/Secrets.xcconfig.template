// Copy this file to Secrets.xcconfig (same folder) and fill in your own
// Supabase project values. Secrets.xcconfig is gitignored — never commit it.
//
// Find these values in your Supabase project dashboard under
// Settings > API.
//
// SUPABASE_URL must NOT include a scheme (no "https://") because xcconfig
// treats "//" as a comment — SupabaseConfig.swift adds "https://" back.

SUPABASE_URL = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
